                    </td>
                </tr>
                <tr>
                    <td>CITY</td>
                    <td>
                        <form>
                            <input type="text" placeholder="Enter The City Name">(max 30 characters a-z and A-Z)
                        </form>
                    </td>
                </tr>
                <tr>
                    <td>PIN CODE</td>
                    <td>
                        <form>
                            <input type="password" placeholder="Enter The Pin Code">(6 Digits Number)
                        </form>
                    </td>
                </tr>
                <tr>
                    <td>STATE</td>
                    <td>
                        <form>
                            <input type="text" placeholder="Enter The State"> (max 30 characters a-z and A-Z
                        </form>
                    </td>
                </tr>
                <tr>
                    <td>COUNTRY</td>
                    <td>
                        <form>
                            <input type="text" placeholder="Enter The Country Name">
                        </form>
                    </td>
                </tr>
                <tr>
                    <td>HOBBIES</td>
                    <td>
                        <form>
                            <input type="checkbox" id="hobby" >
