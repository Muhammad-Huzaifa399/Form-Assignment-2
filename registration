                            <tr>
                                <td>3</td>
                                <td>Graduation</td>
                                <td>
                                    <form>
                                        <input type="text">
                                    </form>
                                </td>
                                <td>
                                    <form>
                                        <input type="text">
                                    </form>
                                </td>
                                <td>
                                    <form>
                                        <input type="text">
