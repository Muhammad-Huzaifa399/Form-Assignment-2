                            </tr>
                            <tr>
                                <td>2</td>
                                <td>Class XII</td>
                                <td>
                                    <form>
                                        <input type="text">
                                    </form>
                                </td>
                                <td>
                                    <form>
                                        <input type="text">
                                    </form>
                                </td>
                                <td>
                                    <form>
                                        <input type="text">
                                    </form>
                                </td>
                            </tr>
