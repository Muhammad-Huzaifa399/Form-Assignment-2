                                </td>
                                <td>
                                    <form>
                                        <input type="text">
                                    </form>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td>
                        COURSES <br>
                        APPLIED FOR
                    </td>
