    <div>
        <center>

            <table>
                <tr>
                    <td colspan="2" style="text-align: center;"><h1>STUDENT REGISTRATION FORM</h1></td>
                </tr>
                
                <tr>
                    <td>FIRST NAME</td>
                    <td>
                        <form>
                            <input type="text" placeholder="Enter The First Name"> (max 30 characters a-z and A-Z)
                        </form>
                    </td>
                </tr>
                <tr>
                    <td>LAST NAME</td>
                    <td>
                        <form>
                            <input type="text" placeholder="Enter The Last Name"> (max 30 characters a-z and A-Z)
                        </form>
                    </td>
                </tr>
                <tr>
                    <td>DATE OF BIRTH</td>
                    <td>
                        <form>
                            <input type="date">
                        </form>
                    </td>
                </tr>
                <tr>
                    <td>EMAIL ID</td>
                    <td>
                        <form>
                            <input type="text" placeholder="Enter The Email Address">
                        </form>
                    </td>
                </tr>
                <tr>
                    <td>MOBILE NUMBER</td>
                    <td>
                        <form>
                            <input type="text" placeholder="Enter The Mobile Number"> (10 Digits Number)
                        </form>
                    </td>
                </tr>
                <tr>
                    <td>GENDER</td>
                    <td>
                        <form>
                            <input type="radio" id="male">
                            <label for="male">Male</label>
                            <input type="radio" id="female">
                            <label for="female">Female</label>
                        </form>
                    </td>
                </tr>
                <tr>
                    <td>ADDRESS</td>
                    <td>
                        <form>
                            <textarea name="Message" id=""></textarea>
